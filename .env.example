# ---------------------------------------------------------------
# ZenWrit — environment variables
# Add every variable below in Vercel → Project → Settings → Environment Variables
# ---------------------------------------------------------------

# Backend (database + auth). Client-side vars MUST keep the VITE_ prefix.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Same values, server-side (used by server functions / webhooks)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-id"
# Secret — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI generation (OpenAI — model: gpt-4o-mini). Server-only, never exposed to the browser.
OPENAI_API_KEY="sk-..."

# Paddle payments — client token (test_... for sandbox, live_... for production)
VITE_PAYMENTS_CLIENT_TOKEN="live_xxx"

# Paddle server-side API keys
PADDLE_SANDBOX_API_KEY=""
PADDLE_LIVE_API_KEY=""

# Paddle webhook signing secrets (endpoint: /api/public/payments/webhook?env=live)
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""
PAYMENTS_LIVE_WEBHOOK_SECRET=""
